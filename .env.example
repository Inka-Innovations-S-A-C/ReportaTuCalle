# ============================================================
# ReportaTuCalle - Variables de entorno requeridas
# Nunca commitear el .env real al repositorio este es de ejemplo
# ============================================================

# Base de datos PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/reportatucalle
DB_USERNAME=tu_usuario_aqui
DB_PASSWORD=tu_password_seguro_aqui

# JWT - Generar secret con: openssl rand -base64 64
JWT_SECRET=reemplazar_con_clave_aleatoria_de_64_bytes
JWT_EXPIRATION=86400000

# URL base del servidor (sin trailing slash)
APP_BASE_URL=https://tu-dominio.com

# CORS - Orígenes permitidos (separados por coma, sin espacios)
CORS_ALLOWED_ORIGINS=https://tu-frontend.com,https://dashboard.tu-dominio.com
